---
import Icon from './Icon.astro';
import { t, type Lang } from '../utils/i18n';

interface Rec {
  name: string;
  tags: string[];
  description: Record<string, string>;
  url?: string;
  rating: number;
}

interface Props {
  item: Rec;
  lang: Lang;
  tagNameById: Record<string, Record<string, string>>;
}

const { item, lang, tagNameById } = Astro.props;
const tags = item.tags.map((id) => ({ id, name: tagNameById[id] })).filter((tag) => tag.name);
const hasUrl = Boolean(item.url);
---

<article class="rec-item" data-tags={item.tags.join(' ')} data-reveal>
  <div class="rec-line">
    {
      hasUrl ? (
        <a
          class="rec-name"
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${item.name} · ${t(lang, 'recommendations.visit')}`}
        >
          {item.name}
          <span class="rec-arrow" aria-hidden="true"><Icon name="external" size={13} /></span>
        </a>
      ) : (
        <span class="rec-name">{item.name}</span>
      )
    }
    <span class="rec-rating" aria-label={`${t(lang, 'recommendations.rating')} ${item.rating}/5`}>
      {
        [1, 2, 3, 4, 5].map((n) => (
          <span class={`star ${n <= item.rating ? 'is-on' : ''}`} aria-hidden="true">
            <Icon name="star" size={13} fill={n <= item.rating} />
          </span>
        ))
      }
    </span>
  </div>
  {tags.length > 0 && (
    <ul class="rec-tags">
      {tags.map((tag) => <li class="chip">{tag.name![lang]}</li>)}
    </ul>
  )}
  <p class="rec-desc">{item.description[lang]}</p>
</article>

<style>
  .rec-item {
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--line);
  }
  .rec-line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .rec-name {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    font-family: var(--font-serif);
    font-size: 19px;
    font-weight: 600;
    text-decoration: none;
    transition: color var(--motion-fast) var(--ease);
  }
  .rec-arrow {
    display: inline-flex;
    align-self: center;
    color: var(--muted);
    transition:
      color var(--motion-fast) var(--ease),
      transform var(--motion-fast) var(--ease);
  }
  .rec-item:hover .rec-name {
    color: var(--accent);
  }
  .rec-item:hover .rec-arrow {
    color: var(--accent);
    transform: translate(3px, -3px);
  }
  .rec-rating {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 2px;
    color: var(--muted);
  }
  .star {
    display: inline-flex;
    color: var(--line-strong);
  }
  .star.is-on {
    color: var(--accent);
  }
  .rec-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-top: var(--space-2);
  }
  .rec-desc {
    margin-top: var(--space-2);
    max-width: 62ch;
    font-size: 13.5px;
    color: var(--soft);
    line-height: 1.7;
  }
</style>
