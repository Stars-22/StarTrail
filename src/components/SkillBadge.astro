---
import Icon from './Icon.astro';
import type { Lang } from '../utils/i18n';

interface Props {
  item: { name: Record<string, string>; icon?: string; badge?: string };
  lang: Lang;
}

const { item, lang } = Astro.props;
const icon = item.icon ?? '';
const isGeneric = icon.startsWith('generic:');
const iconName = isGeneric ? icon.slice('generic:'.length) : icon;
const label = item.name[lang] ?? item.name.zh ?? item.name.en ?? '';
---

<span class="skill-badge">
  {
    iconName ? (
      <span class="sb-ico"><Icon name={iconName} size={14} /></span>
    ) : (
      item.badge && <img class="sb-img" src={item.badge} alt="" loading="lazy" />
    )
  }
  <span class="sb-name">{label}</span>
</span>

<style>
  .skill-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    font-size: 12px;
    line-height: 1.4;
    color: var(--soft);
    transition:
      color var(--motion-fast) var(--ease),
      border-color var(--motion-fast) var(--ease);
  }
  .skill-badge:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .sb-ico {
    display: inline-flex;
    color: var(--accent);
    transition: color var(--motion-fast) var(--ease);
  }
  .skill-badge:hover .sb-ico {
    color: var(--accent-strong);
  }
  .sb-img {
    width: 14px;
    height: 14px;
    display: block;
  }
</style>
