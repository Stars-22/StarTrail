---
import profile from '../data/profile.json';
import site from '../data/site.json';
import { t, type Lang } from '../utils/i18n';
import { features } from '../utils/features';
import { utcOffsetLabel } from '../utils/timezone';
import Nav from './Nav.astro';
import ThemeToggle from './ThemeToggle.astro';
import LangToggle from './LangToggle.astro';
import PoweredBy from './PoweredBy.astro';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  activeNav: string;
  path: string;
}

const { lang, activeNav, path } = Astro.props;
const tzLabel = utcOffsetLabel(profile.timezone, lang === 'zh' ? 'UTC' : 'GMT');
const copyright = site.copyright[lang].replace('{year}', String(new Date().getFullYear()));
---

<aside class="sidebar" aria-label={t(lang, 'nav.ariaLabel')}>
  <div class="sb-inner">
    <div class="sb-top">
      <div class="avatar-wrap">
        <img class="avatar" src={profile.avatar} alt={profile.name[lang]} width="78" height="78" />
      </div>
      <h1 class="sb-name">{profile.name[lang]}</h1>
      <div class="sb-name-sub mono">{profile.name.en.toUpperCase()}</div>
      <ul class="sb-roles">
        {profile.roles[lang].map((role) => <li class="chip">{role}</li>)}
      </ul>
      <p class="sb-loc">
        <Icon name="globe" size={13} />
        <span>{profile.location[lang]} · <span class="mono">{tzLabel}</span></span>
      </p>
    </div>

    <Nav lang={lang} activeNav={activeNav} class="nav" />

    <div class="sb-bottom">
      <div class="sb-controls">
        {features.theme && <ThemeToggle lang={lang} />}
        <LangToggle lang={lang} path={path} />
      </div>
      <div class="sb-foot">
        <div class="sb-foot-row">
          <span>{copyright}</span>
          <a href={site.repoUrl} target="_blank" rel="noopener noreferrer" aria-label={t(lang, 'footer.viewSource')}>
            StarTrail
          </a>
        </div>
        <PoweredBy lang={lang} />
      </div>
    </div>
  </div>
</aside>

<style>
  .sb-inner {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: 44px 34px 26px;
  }
  .avatar-wrap {
    position: relative;
    width: 78px;
    height: 78px;
  }
  .avatar-wrap::after {
    content: '';
    position: absolute;
    right: -2px;
    bottom: -2px;
    width: 11px;
    height: 11px;
    background: var(--accent);
  }
  .avatar {
    width: 78px;
    height: 78px;
    object-fit: cover;
    border-radius: var(--radius-circle);
    border: 1px solid var(--line-strong);
  }
  .sb-name {
    margin-top: var(--space-4);
    font-family: var(--font-serif);
    font-size: var(--text-name);
    font-weight: 600;
    line-height: var(--leading-tight);
  }
  .sb-name-sub {
    margin-top: 5px;
    font-size: 10px;
    letter-spacing: 0.32em;
    color: var(--muted);
  }
  .sb-roles {
    margin-top: var(--space-3);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
  }
  .sb-roles .chip {
    font-size: 11.5px;
  }
  .sb-loc {
    margin-top: var(--space-3);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--muted);
  }
  .sb-bottom {
    margin-top: auto;
    padding-top: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .sb-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .sb-foot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
  }
  .sb-foot-row {
    width: 100%;
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: var(--space-4);
  }
  .sb-foot a {
    text-decoration: none;
  }
  .sb-foot a:hover {
    color: var(--accent);
  }
</style>
