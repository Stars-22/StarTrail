---
import { t, type Lang } from '../utils/i18n';
import type { LocalizedProject } from '../utils/projects';
import Icon from './Icon.astro';

interface Props {
  project: LocalizedProject;
  lang: Lang;
}

const { project, lang } = Astro.props;
const data = project.entry.data;
const href = `/${lang}/projects/${project.base}`;

const fmt = (n?: number): string =>
  n == null ? '–' : n >= 1000 ? `${(n / 1000).toFixed(1).replace(/\.0$/, '')}k` : String(n);

const time = data.end ? `${data.start} – ${data.end}` : `${data.start} – ${t(lang, 'experience.present')}`;
---

<article class={`project-card${data.cover ? ' has-cover' : ''}`}>
  <div class="card-body">
    <h3 class="card-title"><a href={href}>{data.title}</a></h3>
    <span class={`card-badge ${data.openSource ? 'is-oss' : 'is-private'}`}>
      {t(lang, data.openSource ? 'projects.openSource' : 'projects.private')}
    </span>
    <p class="card-desc">{data.description}</p>
    {data.cover && <img class="card-thumb" src={data.cover} alt={data.title} loading="lazy" />}
    {data.tech.length > 0 && <ul class="card-tags">{data.tech.map((tech) => <li class="chip">{tech}</li>)}</ul>}
    <span class="card-time mono">{time}</span>
    {
      data.openSource && (
        <span class="card-stats mono" data-repo={data.repo}>
          <Icon name="star" size={12} />
          <span>{t(lang, 'projects.starsLabel')}</span>
          <b data-stars>{fmt(data.stars)}</b>
          <span class="sep">·</span>
          <Icon name="fork" size={12} />
          <span>{t(lang, 'projects.forksLabel')}</span>
          <b data-forks>{fmt(data.forks)}</b>
        </span>
      )
    }
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: grid;
    border: 1px solid var(--line);
    background: var(--bg2);
    transition:
      border-color var(--motion-base) var(--ease),
      transform var(--motion-base) var(--ease);
  }
  .project-card:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
  }
  /* 有封面时：缩略图绝对定位在卡片中部右侧，文字右留白避免重叠 */
  .project-card.has-cover .card-desc,
  .project-card.has-cover .card-tags {
    padding-right: 112px;
  }
  .card-thumb {
    position: absolute;
    right: var(--space-5);
    top: 50%;
    transform: translateY(-50%);
    width: 96px;
    height: 64px;
    object-fit: cover;
    border: 1px solid var(--line);
  }
  .card-body {
    position: relative;
    display: grid;
    grid-template-areas:
      'title badge'
      'desc desc'
      'tags tags'
      'time stats';
    grid-template-rows: auto 1fr auto auto;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-2) var(--space-3);
    min-height: 176px;
    padding: var(--space-4) var(--space-5);
  }
  .card-title {
    grid-area: title;
    font-family: var(--font-serif);
    font-size: var(--text-md);
    font-weight: 600;
    line-height: var(--leading-tight);
  }
  .card-title a {
    text-decoration: none;
  }
  .card-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card-title a:hover {
    color: var(--accent);
  }
  .card-badge {
    grid-area: badge;
    align-self: start;
    justify-self: end;
    width: fit-content;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    border: 1px solid currentColor;
    border-radius: var(--radius-pill);
    padding: 2.5px 9px;
    white-space: nowrap;
  }
  .card-badge.is-oss {
    color: var(--accent);
  }
  .card-badge.is-private {
    color: var(--muted);
  }
  .card-desc {
    grid-area: desc;
    align-self: start;
    font-size: var(--text-sm);
    color: var(--soft);
    line-height: 1.8;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-tags {
    grid-area: tags;
    align-self: end;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }
  .card-time {
    grid-area: time;
    align-self: end;
    font-size: var(--text-xs);
    color: var(--muted);
  }
  .card-stats {
    grid-area: stats;
    align-self: end;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--muted);
  }
  .card-stats b {
    font-weight: 500;
  }
  .card-stats .sep {
    margin: 0 var(--space-1);
  }
</style>
