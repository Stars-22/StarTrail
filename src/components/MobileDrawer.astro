---
import { t, type Lang } from '../utils/i18n';
import { features } from '../utils/features';
import Nav from './Nav.astro';
import ThemeToggle from './ThemeToggle.astro';
import LangToggle from './LangToggle.astro';

interface Props {
  lang: Lang;
  activeNav: string;
  path: string;
}

const { lang, activeNav, path } = Astro.props;
---

<div
  id="drawer"
  class="drawer"
  hidden
  role="dialog"
  aria-modal="true"
  aria-label={t(lang, 'nav.ariaLabel')}
>
  <Nav lang={lang} activeNav={activeNav} class="nav nav--drawer drawer-nav" />

  <div class="drawer-bottom">
    <div class="drawer-controls">
      {features.theme && <ThemeToggle lang={lang} />}
      <LangToggle lang={lang} path={path} />
    </div>
  </div>
</div>

<style>
  /* 从顶栏下方展开的半透面板（不占满全屏、不遮挡顶栏） */
  .drawer {
    position: fixed;
    top: var(--topbar-h);
    left: 0;
    right: 0;
    z-index: var(--z-drawer);
    display: flex;
    flex-direction: column;
    max-height: calc(100vh - var(--topbar-h));
    overflow-y: auto;
    padding-bottom: var(--space-6);
    /* 字面量 rgba，避免变量/特性检测导致变为不透明 */
    background: rgba(252, 251, 247, 0.45);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity var(--motion-slow) var(--ease),
      transform var(--motion-slow) var(--ease);
  }
  [data-theme='dark'] .drawer {
    background: rgba(50, 46, 40, 0.55);
  }
  .drawer.is-open {
    opacity: 1;
    transform: none;
  }
  .drawer[hidden] {
    display: none;
  }
  /* 导航与切换按钮之间留一段距离，切换按钮左右内缩更多 */
  .drawer-bottom {
    margin-top: var(--space-6);
    padding: 0 var(--space-8);
  }
  .drawer-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  @media (min-width: 768px) {
    .drawer {
      display: none !important;
    }
  }
</style>
