---
import Icon from './Icon.astro';
import { t, type Lang } from '../utils/i18n';

interface ContactEntry {
  type: string;
  value: string;
  label?: Record<string, string>;
}

interface Props {
  item: ContactEntry;
  lang: Lang;
}

const { item, lang } = Astro.props;

const iconByType: Record<string, string> = {
  github: 'github',
  netease: 'netease',
  discord: 'discord',
  email: 'mail',
  website: 'globe',
  leetcode: 'leetcode',
};

const label = item.label?.[lang] ?? t(lang, `contact.${item.type}`);
const icon = iconByType[item.type] ?? 'globe';
const isCopy = item.type === 'discord';
const isEmail = item.type === 'email';
const href = isEmail ? `mailto:${item.value}` : item.value;
const ariaLabel = !isCopy && !isEmail
  ? `${label} · ${item.value} · ${t(lang, 'about.externalLink')}`
  : `${label} · ${item.value}`;
---

<div class="contact-item">
  <span class="ci-icon"><Icon name={icon} size={20} /></span>
  <span class="ci-body">
    <span class="ci-label">{label}</span>
    {
      isCopy ? (
        <button
          class="ci-value mono"
          type="button"
          data-copy={item.value}
          aria-label={ariaLabel}
        >
          {item.value}
        </button>
      ) : (
        <a
          class="ci-value mono"
          href={href}
          target={isEmail ? undefined : '_blank'}
          rel={isEmail ? undefined : 'noopener noreferrer'}
          aria-label={ariaLabel}
        >
          {item.value}
        </a>
      )
    }
  </span>
</div>

<style>
  .contact-item {
    display: grid;
    grid-template-columns: 20px 1fr;
    column-gap: var(--space-3);
    align-items: center;
    width: 100%;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--line);
    color: inherit;
  }
  .ci-icon {
    display: inline-flex;
    color: var(--muted);
  }
  .ci-body {
    min-width: 0;
  }
  .ci-label {
    display: block;
    font-size: 11.5px;
    color: var(--muted);
  }
  .ci-value {
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--motion-fast) var(--ease);
  }
  .ci-value:hover {
    color: var(--accent);
  }
</style>
