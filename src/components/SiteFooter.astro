---
import site from '../data/site.json';
import PoweredBy from './PoweredBy.astro';
import { t, type Lang } from '../utils/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copyright = site.copyright[lang].replace('{year}', String(new Date().getFullYear()));
---

<footer class="site-footer">
  <div class="sf-row">
    <span>{copyright}</span>
    <a href={site.repoUrl} target="_blank" rel="noopener noreferrer" aria-label={t(lang, 'footer.viewSource')}>
      StarTrail
    </a>
  </div>
  <PoweredBy lang={lang} />
</footer>

<style>
  .site-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
  }
  .sf-row {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: var(--space-4);
  }
  a {
    text-decoration: none;
  }
  a:hover {
    color: var(--accent);
  }
  /* 桌面端页脚信息仅在侧栏呈现 */
  @media (min-width: 768px) {
    .site-footer {
      display: none;
    }
  }
</style>
