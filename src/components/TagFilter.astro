---
import { t, type Lang } from '../utils/i18n';

interface TagGroup {
  id: string;
  name: Record<string, string>;
  tags: { id: string; name: Record<string, string> }[];
}

interface Props {
  tagGroups: TagGroup[];
  lang: Lang;
}

const { tagGroups, lang } = Astro.props;
---

<div class="tag-filter" role="group" aria-label={t(lang, 'recommendations.filter')}>
  <button class="filter-btn is-active" type="button" data-filter="all" aria-pressed="true">
    {t(lang, 'recommendations.all')}
  </button>
  {
    tagGroups.map((group) => (
      <div class="filter-group">
        {group.tags.map((tag) => (
          <button class="filter-btn" type="button" data-filter={tag.id} aria-pressed="false">
            {tag.name[lang]}
          </button>
        ))}
      </div>
    ))
  }
</div>

<style>
  .tag-filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }
  .filter-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .filter-group + .filter-group {
    margin-left: var(--space-3);
  }
  .filter-btn {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.04em;
    padding: 6px 15px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    color: var(--muted);
    transition:
      color var(--motion-fast) var(--ease),
      border-color var(--motion-fast) var(--ease);
  }
  .filter-btn:hover {
    color: var(--ink);
    border-color: var(--soft);
  }
  .filter-btn.is-active {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
