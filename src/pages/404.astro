---
import site from '../data/site.json';
import { t } from '../utils/i18n';
import '../styles/tokens.css';
import '../styles/global.css';

const langs: Array<'zh' | 'en'> = ['zh', 'en'];
---

<!doctype html>
<html lang={site.defaultLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 · {site.title}</title>
  </head>
  <body>
    <main class="error-page">
      {
        langs.map((lang) => (
          <div class="err-col" lang={lang}>
            <p class="err-code mono">404</p>
            <h1>{t(lang, 'error.title')}</h1>
            <p class="err-desc">{t(lang, 'error.description')}</p>
            <a class="err-link" href={`/${lang}/`}>{t(lang, 'error.backHome')}</a>
          </div>
        ))
      }
    </main>
  </body>
</html>

<style>
  .error-page {
    display: grid;
    gap: var(--space-8);
    max-width: var(--content-w);
    margin-inline: auto;
    padding: var(--space-9) var(--space-5);
  }
  @media (min-width: 768px) {
    .error-page {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .err-code {
    font-size: var(--text-xs);
    color: var(--accent);
    letter-spacing: 0.14em;
  }
  .err-col h1 {
    margin-top: var(--space-3);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 600;
  }
  .err-desc {
    margin-top: var(--space-3);
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .err-link {
    display: inline-block;
    margin-top: var(--space-4);
    padding-bottom: 2px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    font-size: var(--text-sm);
    transition:
      color var(--motion-fast) var(--ease),
      border-color var(--motion-fast) var(--ease);
  }
  .err-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
