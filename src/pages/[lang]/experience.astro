---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import SkillGroup from '../../components/SkillGroup.astro';
import ExperienceItem from '../../components/ExperienceItem.astro';
import AwardItem from '../../components/AwardItem.astro';
import skills from '../../data/skills.json';
import experience from '../../data/experience.json';
import awards from '../../data/awards.json';
import site from '../../data/site.json';
import { t, langs, type Lang } from '../../utils/i18n';
import { features, hasExperiencePage } from '../../utils/features';

export function getStaticPaths() {
  if (!hasExperiencePage) return [];
  return langs().map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const sortedAwards = [...awards].sort((a, b) => b.year - a.year);
---

<BaseLayout
  lang={lang}
  title={t(lang, 'meta.title.experience', { site: site.title })}
  description={t(lang, 'meta.description.experience')}
  activeNav="experience"
>
  <SectionHeader
    title={t(lang, 'pageTitle.experience')}
    subtitle={t(lang, 'pageSubtitle.experience')}
  />

  {
    features.skills && (
      <section class="section">
        <h2>{t(lang, 'experience.skills')}</h2>
        <div class="skill-groups">
          {skills.categories.map((group) => <SkillGroup group={group} lang={lang} />)}
        </div>
      </section>
    )
  }

  {
    features.experience && (
      <section class="section">
        <h2>{t(lang, 'experience.work')}</h2>
        <div class="exp-list">
          {experience.map((item) => <ExperienceItem item={item} lang={lang} />)}
        </div>
      </section>
    )
  }

  {
    features.awards && (
      <section class="section">
        <h2>{t(lang, 'experience.awards')}</h2>
        <div class="award-list">
          {sortedAwards.map((item) => <AwardItem item={item} lang={lang} />)}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .skill-groups,
  .award-list {
    margin-top: var(--space-5);
  }
  .exp-list {
    border-left: 1px solid var(--line-strong);
    margin: 34px 0 4px 5px;
    padding-left: 28px;
  }
</style>
